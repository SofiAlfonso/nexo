# Plantilla de ejemplo — NO contiene valores reales.
# Copia este archivo fuera de Git (p. ej. como .env local o como Secret de
# Kubernetes creado manualmente) y completa los valores reales ahí.
# Este archivo de ejemplo debe permanecer siempre con placeholders.

# PostgreSQL local (D1 — transaccional por sede, usado por C2)
LOCAL_POSTGRES_HOST=localhost
LOCAL_POSTGRES_PORT=5433
LOCAL_POSTGRES_DB=changeme
LOCAL_POSTGRES_USER=changeme
LOCAL_POSTGRES_PASSWORD=changeme

# PostgreSQL central (D2 — usado por C4)
CENTRAL_POSTGRES_HOST=localhost
CENTRAL_POSTGRES_PORT=5434
CENTRAL_POSTGRES_DB=changeme
CENTRAL_POSTGRES_USER=changeme
CENTRAL_POSTGRES_PASSWORD=changeme

# Sesión de usuario (secreto para firmar la cookie de sesión)
SESSION_COOKIE_SECRET=changeme

# Exportación OTLP al backend local de observabilidad (grafana/otel-lgtm)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Grafana Cloud (OTLP) — opcional.
# Estos valores se guardan en el Kubernetes Secret nexo-grafana-cloud
# del namespace nexo-observability.
GRAFANA_CLOUD_OTLP_ENDPOINT=changeme
GRAFANA_CLOUD_INSTANCE_ID=changeme
GRAFANA_CLOUD_OTLP_TOKEN=changeme

# Kubernetes / Minikube
KUBECONFIG_PATH=changeme
