# Plantilla de ejemplo — NO contiene valores reales.
# Copia este archivo fuera de Git (p. ej. como .env local o como Secret de
# Kubernetes creado manualmente) y completa los valores reales ahí.
# Este archivo de ejemplo debe permanecer siempre con placeholders.

# PostgreSQL (D2 — persistencia central)
POSTGRES_HOST=changeme
POSTGRES_PORT=5432
POSTGRES_DB=changeme
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# Persistencia transaccional local (D1)
LOCAL_DB_PATH=changeme

# Grafana Cloud (OTLP)
GRAFANA_CLOUD_OTLP_ENDPOINT=changeme
GRAFANA_CLOUD_OTLP_TOKEN=changeme

# Kubernetes / Minikube
KUBECONFIG_PATH=changeme
