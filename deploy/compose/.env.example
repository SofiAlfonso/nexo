# Entorno local de desarrollo; npm run dev lo consume mediante
# docker compose --env-file.
D1_PORT=5433
D1_POSTGRES_DB=nexo_venue
D1_POSTGRES_USER=nexo_venue
D1_POSTGRES_PASSWORD=nexo_venue_dev

D2_PORT=5434
D2_POSTGRES_DB=nexo_central
D2_POSTGRES_USER=nexo_central
D2_POSTGRES_PASSWORD=nexo_central_dev

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Puertos HTTP de los servicios levantados por `npm run dev` (T27/scripts/dev.mjs).
CENTRAL_PORT=4000
COORDINATOR_PORT=4001
TICKETING_PORT=4002

# URL que usan C1 y C2 para hablar con C4 en desarrollo local.
CENTRAL_URL=http://localhost:4000

# Solo para el laboratorio local (`npm run dev`): NO son secretos reales.
# Contraseña de los operadores sembrados en D2 (5 roles del prototipo, ADR-016).
SEED_OPERATOR_PASSWORD=nexo_operador_dev
# Clave para firmar la cookie de sesión de C4 en desarrollo; cambiar fuera del laboratorio.
SESSION_COOKIE_SECRET=nexo_dev_session_cookie_secret_change_me
